{
  "name": "m365-admin-toolbox",
  "productName": "M365 Admin Toolbox",
  "version": "0.3.0",
  "description": "Multi-tenant Microsoft 365 admin toolbox by RHIS",
  "author": "RHIS",
  "license": "GPL-3.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/sora": "^5.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
